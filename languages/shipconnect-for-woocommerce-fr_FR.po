msgstr "Commencez par le test : aucun envoi réel n’est créé."

msgid "International product type"
msgstr "Type de produit à l’international"

msgid "Economy Parcel Express: e-commerce, goods"
msgstr "Economy Parcel Express : e-commerce, marchandises"

msgid "Priority Parcel Express: priority delivery"
msgstr "Priority Parcel Express : livraison prioritaire"

msgid "Deferred Parcel Express: second-day delivery"
msgstr "Deferred Parcel Express : livraison en 2e jour"

msgid "Used for shipments leaving the origin country. Shipments within the same country automatically use the domestic product."
msgstr "Utilisé pour les envois hors pays d’origine. Les envois au sein du même pays utilisent automatiquement le produit domestique."

msgid "Flat rate (optional)"
msgstr "Tarif forfaitaire (optionnel)"

