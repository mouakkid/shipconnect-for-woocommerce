msgstr "Proposé au checkout tant que les tarifs Aramex en direct ne sont pas branchés. Dans la devise de votre boutique."

msgid "Connected to Aramex (%s)."
msgstr "Connexion réussie à Aramex (%s)."

msgid "production"
msgstr "production"

msgid "test environment"
msgstr "environnement de test"

msgid "Flat rate"
msgstr "Tarif forfaitaire"

msgid "Aramex did not return a tracking number (AWB)."
msgstr "Aramex n’a pas renvoyé de numéro de suivi (AWB)."

msgid "Automatic Aramex tracking is not available yet. Use manual tracking if needed."
msgstr "Le suivi automatique Aramex n’est pas encore disponible. Utilisez le suivi manuel si besoin."

msgid "Aramex rejected the request without details."
msgstr "Aramex a refusé la demande sans précision."

msgid "Goods"
msgstr "Marchandises"

msgid "Moroccan carrier: rates by city, shipment creation with cash on delivery and tracking. No label through the public API."
msgstr "Transporteur marocain : tarifs par ville, création d'envoi avec paiement à la livraison et suivi. Pas d'étiquette via l'API publique."

msgid "API key"
msgstr "Clé API"

msgid "In your Atlas Livraison dashboard: API settings. The API must first be activated for your account."
msgstr "Dans votre tableau de bord Atlas Livraison : réglages API. L'API doit d'abord être activée pour votre compte."

msgid "Store ID (optional)"
msgstr "ID de la boutique (facultatif)"

msgid "Only needed if your account has several stores. Without it, parcels are attached to your store automatically."
msgstr "Utile seulement si votre compte a plusieurs boutiques. Sinon, les colis sont rattachés automatiquement à votre boutique."

msgid "Customer may open the parcel"
msgstr "Le client peut ouvrir le colis"

msgid "No"
msgstr "Non"

msgid "Yes"
msgstr "Oui"

msgid "Used when the carrier API returns no price for the destination. In dirhams."
msgstr "Utilisé quand l'API du transporteur ne renvoie pas de prix pour la destination. En dirhams."

msgid "Connected to %1$s (%2$d cities served)."
msgstr "Connecté à %1$s (%2$d villes desservies)."

msgid "%s needs a Moroccan mobile number (06 or 07 followed by 8 digits). Correct the phone number in the order."
msgstr "%s exige un numéro de mobile marocain (06 ou 07 suivi de 8 chiffres). Corrigez le téléphone dans la commande."

msgid "%s only accepts a cash-on-delivery amount in whole dirhams. Round the order total, then try again."
msgstr "%s n'accepte qu'un montant à encaisser en dirhams entiers. Arrondissez le total de la commande, puis réessayez."

msgid "%s needs a delivery address of at least 10 characters. Complete the address in the order."
msgstr "%s exige une adresse de livraison d'au moins 10 caractères. Complétez l'adresse dans la commande."

msgid "%s did not return a tracking number."
msgstr "%s n'a pas renvoyé de numéro de suivi."

msgid "Missing tracking number."
msgstr "Numéro de suivi manquant."

msgid "%s did not return a parcel status."
msgstr "%s n'a pas renvoyé de statut de colis."

msgid "%s rejected the request."
msgstr "%s a refusé la demande."

msgid "%s did not return its list of cities."
msgstr "%s n'a pas renvoyé sa liste de villes."

msgid "Moroccan carrier: shipment creation with cash on delivery, tracking and cancellation. No label through the API."
msgstr "Transporteur marocain : création d'envoi avec paiement à la livraison, suivi et annulation. Pas d'étiquette via l'API."

msgid "Public key"
