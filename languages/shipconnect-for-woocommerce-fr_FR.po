msgid "Typical flow: the customer orders, you confirm by phone, you set the order to \"Confirmed\" and ShipConnect sends it to the carrier."
msgstr "Déroulé type : le client commande, vous confirmez par téléphone, vous passez la commande à « Confirmée » et ShipConnect l'envoie au transporteur."

msgid "Add a \"Confirmed\" order status"
msgstr "Ajouter un statut de commande « Confirmée »"

msgid "Shown in the orders list and in the bulk actions."
msgstr "Visible dans la liste des commandes et dans les actions groupées."

msgid "Put cash on delivery orders on hold until you confirm them"
msgstr "Mettre en attente les commandes en paiement à la livraison jusqu'à leur confirmation"

msgid "Send to the carrier automatically when the order reaches the trigger status"
msgstr "Envoyer automatiquement au transporteur quand la commande atteint le statut déclencheur"

msgid "Uses the rate chosen at checkout, or your first API carrier. Carriers without an API wait for a tracking number."
msgstr "Utilise le tarif choisi à la commande, ou votre premier transporteur par API. Les transporteurs sans API attendent un numéro de suivi."

msgid "Trigger status"
msgstr "Statut déclencheur"

msgid "The \"Send to carrier\" button in the orders list works at any status."
msgstr "Le bouton « Envoyer au transporteur » de la liste des commandes fonctionne quel que soit le statut."

msgid "Order status after the shipment is created"
msgstr "Statut de la commande après création de l'envoi"

